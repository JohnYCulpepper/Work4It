<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer transparent-ish circle -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#80FFFFFF" />
        </shape>
    </item>

    <item
        android:top="6dp"
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp">
        <shape android:shape="oval">
            <solid android:color="#000000" />
        </shape>
    </item>
    <!-- Inner red circle -->
    <item
        android:top="12dp"
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp">
        <shape android:shape="oval">
            <solid android:color="#E94560" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>